class Solution:
    def __init__(
        self,
        list_province: list[str],
        list_ward: list[str],
        list_street: list[str]
    ):
        self.list_province = list_province
        self.list_ward = list_ward
        self.list_street = list_street

        self.entity_map = {}
        
        # 1. GOM NHÓM THỰC THỂ: Khắc phục lỗi "Lào Cai", "Quang Trung"
        # Một từ khóa (chuỗi string) sẽ trỏ tới 1 dict chứa tất cả các loại nó có thể là.
        def add_entities(entities: list[str], entity_type: str):
            for original_name in entities:
                # Chuẩn hóa khoảng trắng để tránh lỗi dư space
                name_lower = " ".join(original_name.lower().split())
                if not name_lower:
                    continue
                if name_lower not in self.entity_map:
                    self.entity_map[name_lower] = {}
                # Ghi nhận loại entity (province/ward/street) cho chuỗi này
                self.entity_map[name_lower][entity_type] = original_name

        add_entities(self.list_province, "province")
        add_entities(self.list_ward, "ward")
        add_entities(self.list_street, "street")

        self.patterns = list(self.entity_map.keys())
        
        self.automaton = daachorse.CharwiseDoubleArrayAhoCorasick(
            self.patterns, 
            match_kind=daachorse.MATCH_KIND_LEFTMOST_LONGEST
        )

    def process(self, s: str):
        # Chuẩn hóa đầu vào
        s_lower = " ".join(s.lower().split())
        valid_matches = []
        
        # 2. LỌC BIÊN TỪ (Word Boundary Filter)
        # Chạy thuật toán C++ cực nhanh (chỉ O(N))
        for match in self.automaton.find(s_lower):
            start = match[0]
            end = match[1]
            pattern_id = match[2]
            
            # Kiểm tra Word Boundary: Đảm bảo match không nằm giữa một từ khác.
            # Fix lỗi: Số "1" bị nhận diện bên trong số nhà "103" hoặc "423/18"
            if start > 0 and s_lower[start-1].isalnum():
                continue
            if end < len(s_lower) and s_lower[end].isalnum():
                continue
                
            pat_str = self.patterns[pattern_id]
            pat_dict = self.entity_map[pat_str]
            valid_matches.append((start, end, pat_dict))
            
        # 3. CHIẾN LƯỢC QUÉT TỪ PHẢI SANG TRÁI (Right-to-Left Strategy)
        # Địa chỉ luôn theo cấu trúc: [...Số nhà] -> [Tên Đường] -> [Phường] -> [Tỉnh]
        # Xếp các vị trí match theo thứ tự index giảm dần
        valid_matches.sort(key=lambda x: x[0], reverse=True)
        
        result = {
            "province": None,
            "ward": None,
            "street": None,
        }
        
        used_intervals = []
        
        def is_overlap(st, en):
            for us, ue in used_intervals:
                if not (en <= us or st >= ue): # Có giao nhau (overlap)
                    return True
            return False

        # Phân bổ từ Phải -> Trái. Ưu tiên cấp Tỉnh -> cấp Phường -> cấp Đường.
        # Logic này sẽ gỡ triệt để các câu như "Hồng Hà (đường), Hồng Hà (phường)".
        for entity_type in ["province", "ward", "street"]:
            for st, en, pat_dict in valid_matches:
                if entity_type in pat_dict and not is_overlap(st, en):
                    result[entity_type] = pat_dict[entity_type]
                    used_intervals.append((st, en))
                    break
                    
        return result